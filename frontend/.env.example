# ==========================================
# CodeVerse Frontend Environment Configuration
# ==========================================

# Base URL for Backend REST API
# In development, Vite reverse-proxies /api requests to http://localhost:5000.
# In production deployments, leave as '/api' for same-origin gateway reverse-proxying,
# or set to a fully-qualified URL (e.g. https://api.codeverse.io/api) for cross-origin setups.
VITE_API_BASE_URL=/api
