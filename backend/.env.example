# ==========================================
# CodeVerse Backend Environment Configuration
# ==========================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (Comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Primary Document Store (MongoDB Replica Set Required)
# IMPORTANT: CodeVerse transactional progression (campaign rewards and guild operations)
# strictly requires multi-document ACID transactions, which are available ONLY on a MongoDB
# replica set. A standalone MongoDB instance without a replicaSet parameter will fail
# transactional operations.
#
# Option A (External Replica Set):
# Connects to an existing MongoDB replica set (local or cloud like Atlas).
# MONGODB_URI=mongodb://127.0.0.1:27017/codeverse?replicaSet=rs0
#
# Option B (Managed Local Development Mode):
# Running 'npm run start:local' automatically launches and persists an isolated local
# WiredTiger replica set into '.local-db/' on port 27017 without requiring an external MongoDB install.
MONGODB_URI=mongodb://127.0.0.1:27017/codeverse?replicaSet=rs0

# JWT Authentication Configuration
# Production strictly requires a secure, custom JWT_SECRET (minimum 32 characters).
# Development and test environments accept the default dev secret below.
JWT_SECRET=dev_secret_key_for_local_development_only_replace_in_prod
JWT_EXPIRES_IN=24h

# AI Flight Mentor Configuration (Optional)
# When LLM_API_KEY is not configured or fails, CodeVerse seamlessly provides
# deterministic autonomous offline guidance covering all 24 campaign sectors.
# LLM_API_KEY=your_llm_api_key_here
# LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
# LLM_MODEL=gemini-1.5-flash
# LLM_TIMEOUT_MS=8000
