# ==========================================
# CodeVerse Backend Environment Configuration
# ==========================================

# Server Port and Environment
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (Comma-separated if multiple)
CORS_ORIGIN=http://localhost:5173

# Primary Document Store (MongoDB) - Planned MVP
MONGODB_URI=mongodb://localhost:27017/codeverse

# JWT Authentication Secrets (Planned MVP)
# Replace with a secure, randomly generated secret (min 32 chars) in production
JWT_SECRET=dev_secret_key_for_local_development_only_replace_in_prod
JWT_EXPIRES_IN=24h

# Relational Database URL (PostgreSQL) - Planned Phase 4
# DATABASE_URL=postgresql://user:password@localhost:5432/codeverse

# Google Gemini API Key - Planned Phase 2
# GEMINI_API_KEY=your_gemini_api_key_here
